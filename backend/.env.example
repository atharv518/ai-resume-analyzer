# ─── CORS: Comma-separated frontend origins allowed to call the API ───
# Include your Vercel frontend URL, localhost origins for development, and any custom domains.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://your-frontend.vercel.app

# ─── AI Configuration ───
# AI_PROVIDER: "gemini" or "openai" (defaults to intelligent deterministic NLP fallback if no API key)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT_SECONDS=20

# ─── Upload Size Limit ───
# Maximum resume upload size in megabytes.
# Vercel serverless functions have a 4.5 MB request payload limit.
# Default: 4 MB on Vercel, 10 MB on Render / local.
MAX_UPLOAD_SIZE_MB=4

# ─── Feature Flags (True / False) ───
SHOW_ATS_SCORE=True
SHOW_SKILL_MATCH=True
SHOW_KEYWORD_ANALYSIS=True
SHOW_EXPERIENCE_ANALYSIS=True
SHOW_PROJECT_ANALYSIS=True
SHOW_AI_RECOMMENDATIONS=True
SHOW_RESUME_STRENGTHS=True

# ─── Rate Limiting ───
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
