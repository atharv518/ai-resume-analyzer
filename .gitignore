# Environment variables (ignore all .env files and variations, preserve .env.example)
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!.env.example

# Node / Frontend dependencies & caches
node_modules/
**/node_modules/
.npm-cache/
**/.npm-cache/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
**/env/
**/ENV/

# Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pip-cache/
**/.pip-cache/

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
coverage/
**/coverage/
htmlcov/

# Build & Distribution Artifacts
dist/
**/dist/
build/
**/build/
*.egg-info/
**/*.egg-info/

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
pyrefly.toml
